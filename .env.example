# ============================================================================
# Environment variables. Copy this file to `.env` and fill in real values.
# Never commit `.env`. This is the ONLY env file that should be committed.
# `make dev` generates `.env` from this file automatically via
# scripts/setup/env.sh (auto-picks free ports, derives the DB name).
# ============================================================================

# --- Database -----------------------------------------------------------------
# Postgres is shared infra (docker-compose.infra.yml) — one instance per
# machine, reached internally as postgres:5432 on the infra_default network.
# POSTGRES_DB is this copy's database, created lazily by scripts/db/create.sh
# on `make dev`; scripts/setup/env.sh fills it from the sanitized directory name.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Machine-level host port of the shared postgres — every copy must agree on
# it; scripts/setup/env.sh writes the fixed default. For host tooling only (psql, GUIs);
# the backend never uses it.
POSTGRES_HOST_PORT=55432
# Only needed when running the backend on the HOST (uv run uvicorn) instead of
# in Docker; the compose service overrides it with the internal DSN either way.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/app
# Same for shared-infra Redis (host runs only; compose uses redis://redis:6379/0).
# REDIS_URL=redis://localhost:56379/0

# --- AI gateway -----------------------------------------------------------------
# Any OpenAI-compatible endpoint: Bifrost, LiteLLM, or empty for api.openai.com.
# The app never manages providers, keys, fallbacks, or budgets — the gateway
# does. Pointing at a gateway running on the host from inside Docker:
#   AI_BASE_URL=http://host.docker.internal:8080/v1
AI_BASE_URL=
# Gateway virtual key, or a provider key when hitting a provider directly.
AI_API_KEY=
# Model names the app requests. Routing/fallback happen at the gateway.
AI_CHAT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1-mini
AI_TTS_MODEL=tts-1
AI_STT_MODEL=whisper-1
# Per-operation timeout (seconds; connect and each read) for gateway calls.
# AI_TIMEOUT_S=120
# Optional comma-separated fallback chains (provider/model form), sent as
# Bifrost's `fallbacks` request field — one per modality, works on every
# request type. Each overrides gateway-side fallbacks for its request type
# when set; leave empty to let the gateway decide.
# AI_CHAT_FALLBACKS=anthropic/claude-3-5-sonnet-20241022,gemini/gemini-1.5-pro
# AI_IMAGE_FALLBACKS=
# AI_TTS_FALLBACKS=
# AI_STT_FALLBACKS=

# --- Debug feature ----------------------------------------------------------------
# The analysis call streams nothing for ~90 s and has taken 130 s, so it gets
# its own per-read timeout, longer than AI_TIMEOUT_S.
# DEBUG_AI_TIMEOUT_S=300
# kicad-cli must be at least as new as the KiCad that saved the user's files.
# KICAD_CLI=kicad-cli
# KICAD_TIMEOUT_S=60
# DEBUG_MAX_FILES=200
# DEBUG_MAX_UPLOAD_BYTES=20971520

# --- App ------------------------------------------------------------------------
# Display name: API title (OpenAPI/docs), startup log, and the browser tab
# (compose maps it to VITE_APP_NAME; mkdocs reads it via !ENV). Rename the
# project by editing this — scripts/setup/env.sh seeds it from the directory
# name on first `make dev`.
PROJECT_NAME=Häxrök
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Backend also writes logs here (path relative to /app in the container,
# bind-mounted from ./logs on the host). Empty = stdout only.
LOG_FILE=logs/backend/app.log
# Browser console/error batches (POST /api/v1/logs/frontend) are appended
# here. Empty = the endpoint accepts and discards.
FRONTEND_LOG_FILE=logs/frontend/app.log
# Generated media is stored here (bind-mounted from ./data on the host) and
# served back at /media/files/<name>.
MEDIA_DIR=data/media
MEDIA_MAX_BYTES=10485760

# CORS — comma-separated list of allowed origins.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Voice ------------------------------------------------------------------------
# Server-side echo cancellation for voice mode, behind the browser's own
# getUserMedia AEC (which remains the primary line). off = browser AEC only;
# speex = SpeexDSP via libspeexdsp1 (installed in the backend image);
# webrtc = WebRTC AEC3 via pywebrtc-audio — the optional `webrtc` extra:
# installed in dev/CI; a deployed image needs the build arg
# UV_EXTRAS="--extra webrtc" (see backend/Dockerfile).
VOICE_ECHO_CANCELLER=off
# Extra far-end lag (ms) seeded before playback, covering fixed
# network/acoustic delay — under-estimate rather than over-estimate.
# VOICE_EC_DELAY_MS=0
# Speex only: adaptive filter tail (ms); must exceed the residual echo delay.
# VOICE_EC_FILTER_MS=256

# --- Frontend ---------------------------------------------------------------------
# Vite exposes only VITE_ prefixed vars to the client.
VITE_API_URL=http://localhost:8000

# --- Docker Compose -----------------------------------------------------------------
# App ports are per-copy; scripts/setup/env.sh picks free ones so several clones can
# run side by side.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# Host port for `make docs-serve` (mkdocs preview of docs/).
DOCS_HOST_PORT=8001
# COMPOSE_PROJECT_NAME isolates containers/volumes/networks (defaults to the
# directory name if unset).
# COMPOSE_PROJECT_NAME=myapp
