# ============================================================================
# Environment variables. Copy this file to `.env` and fill in real values.
# Never commit `.env`. This is the ONLY env file that should be committed.
# `make dev` generates `.env` from this file automatically via
# scripts/setup/env.sh (auto-picks free ports, seeds PROJECT_NAME).
# ============================================================================

# --- Redis ----------------------------------------------------------------------
# Redis is shared infra (docker-compose.infra.yml) — one instance per machine,
# reached internally as redis:6379 on the infra_default network. Only needed
# when running the backend on the HOST (uv run uvicorn) instead of in Docker;
# the compose service overrides it either way.
# REDIS_URL=redis://localhost:56379/0

# --- AI gateway -----------------------------------------------------------------
# Any OpenAI-compatible endpoint: Bifrost, LiteLLM, or empty for api.openai.com.
# The app never manages providers, keys, fallbacks, or budgets — the gateway
# does. Pointing at a gateway running on the host from inside Docker:
#   AI_BASE_URL=http://host.docker.internal:8080/v1
AI_BASE_URL=
# Gateway virtual key, or a provider key when hitting a provider directly.
AI_API_KEY=
# Model names the app requests. Routing/fallback happen at the gateway.
AI_CHAT_MODEL=gpt-4o-mini
# Per-operation timeout (seconds; connect and each read) for gateway calls.
# AI_TIMEOUT_S=120
# Optional comma-separated fallback chain (provider/model form), sent as
# Bifrost's `fallbacks` request field. Overrides gateway-side fallbacks when
# set; leave empty to let the gateway decide.
# AI_CHAT_FALLBACKS=anthropic/claude-3-5-sonnet-20241022,gemini/gemini-1.5-pro
# Seconds a gateway answer stays cached in Redis, keyed by the whole request
# (model, fallbacks, messages, schema). 0 = always call the model.
# AI_CACHE_TTL_S=604800

# --- Debug feature ----------------------------------------------------------------
# The analysis call streams nothing for ~90 s and has taken 130 s, so it gets
# its own per-read timeout, longer than AI_TIMEOUT_S.
# DEBUG_AI_TIMEOUT_S=300
# kicad-cli must be at least as new as the KiCad that saved the user's files.
# KICAD_CLI=kicad-cli
# KICAD_TIMEOUT_S=60
# ngspice draws a flagged I²C line on its card; missing or failing, no plot.
# NGSPICE=ngspice
# NGSPICE_TIMEOUT_S=10
# DEBUG_MAX_FILES=200
# DEBUG_MAX_UPLOAD_BYTES=20971520

# --- App ------------------------------------------------------------------------
# Display name: API title (OpenAPI/docs), startup log, and the browser tab
# (compose maps it to VITE_APP_NAME; mkdocs reads it via !ENV). Rename the
# project by editing this — scripts/setup/env.sh seeds it from the directory
# name on first `make dev`.
PROJECT_NAME=Häxrök
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Backend also writes logs here (path relative to /app in the container,
# bind-mounted from ./logs on the host). Empty = stdout only.
LOG_FILE=logs/backend/app.log
# Browser console/error batches (POST /api/v1/logs/frontend) are appended
# here. Empty = the endpoint accepts and discards.
FRONTEND_LOG_FILE=logs/frontend/app.log

# CORS — comma-separated list of allowed origins.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------------
# Vite exposes only VITE_ prefixed vars to the client.
VITE_API_URL=http://localhost:8000

# --- Docker Compose -----------------------------------------------------------------
# App ports are per-copy; scripts/setup/env.sh picks free ones so several clones can
# run side by side.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# Host port for `make docs-serve` (mkdocs preview of docs/).
DOCS_HOST_PORT=8001
# COMPOSE_PROJECT_NAME isolates containers/volumes/networks (defaults to the
# directory name if unset).
# COMPOSE_PROJECT_NAME=myapp
