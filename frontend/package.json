{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --cache --cache-location node_modules/.tmp/eslint.cache",
    "format": "prettier --write \"src/**\" \"*.{js,ts,json,html}\"",
    "format:check": "prettier --check \"src/**\" \"*.{js,ts,json,html}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.106.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
